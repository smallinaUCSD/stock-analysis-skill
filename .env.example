# Copy this file to `.env` and paste your real keys. `.env` is gitignored -- it
# NEVER gets committed. The launcher (scripts/serve_ngrok.sh) loads it.
#
# Get these from your Render dashboard -> the stockskill service -> Environment.

# Financial Modeling Prep -- fundamentals + single-symbol data.
FMP_API_KEY=

# Finnhub -- real-time quotes for the live price overlay.
FINNHUB_API_KEY=

# Optional: Buy-me-a-coffee link shown on the board.
STOCKSKILL_BMC_URL=

# Upstash is NOT needed locally: your Mac's disk is persistent, so added tickers
# persist to data/added.json instead (via STOCKSKILL_ADDED_FILE, set by the
# launcher). Leave these blank unless you specifically want the shared store.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# SEC EDGAR (financial statements, 13F fund holdings): the SEC requires a contact
# on every request, "Your Name your@email.com". Free, no key. Without it, SEC data is skipped.
SEC_USER_AGENT=

# --- Accounts on the public site (STOCKSKILL_AUTH=1 is set by scripts/macmini/run.sh) ---
# The site's public address. Needed for passkeys and secure cookies, e.g.
# https://your-mac.your-tailnet.ts.net
STOCKSKILL_PUBLIC_URL=
# "Sign in with Google": create an OAuth client ID (type "Web application") at
# https://console.cloud.google.com/apis/credentials and add your public address
# under "Authorized JavaScript origins". Leave blank to hide the Google button.
GOOGLE_CLIENT_ID=
# Shown in the Terms of Service and Privacy Policy.
STOCKSKILL_OPERATOR="SMI Investments"
STOCKSKILL_CONTACT_EMAIL=
